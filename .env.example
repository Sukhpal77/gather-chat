MONGODB_URI=mongodb://127.0.0.1:27017/gather
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=http://localhost:3000
# Enable when serving behind HTTPS in production.
COOKIE_SECURE=false
# Optional: password reset delivery. Without SMTP, reset requests return 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Gather <hello@example.com>
